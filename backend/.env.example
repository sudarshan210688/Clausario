# HTTP port the Express server listens on (integer 1–65535).
PORT=5000

# OKF knowledge bundle directory; relative paths resolve against backend/.
KNOWLEDGE_DIR=./knowledge

# GDPR source site (Chapters I–X, Art. 1–93 + linked recitals are scraped from here).
GDPR_BASE_URL=https://gdpr-info.eu

# EU AI Act source site (Chapters I–X incl. Omnibus-inserted articles, Annex I–X + linked recitals are scraped from here).
EU_AI_ACT_BASE_URL=https://artificialintelligenceact.eu

# Delay between sequential scrape requests, in milliseconds.
SCRAPE_DELAY_MS=1000

# OpenAI API key. Required for /api/analyze (Decisions), when DESCRIPTION_MODEL is set, and for the openai generation provider.
OPENAI_API_KEY=
# OpenAI chat model for one-line OKF descriptions. Empty → deterministic template descriptions (no LLM).
DESCRIPTION_MODEL=gpt-4o-mini-2024-07-18

# OpenAI Decisions model for route / select (only gpt-6-luna is supported).
DECISIONS_MODEL=gpt-6-luna

# ROUTE: a regulation applies when its predicate probability (personal data / AI system) is >= this (0–1).
ROUTE_THRESHOLD=0.5

# ROUTE: needsReview when the regulation choice confidence is below this (0–1).
ROUTE_MIN_CONFIDENCE=0.6

# SELECT stage 1: keep chapters with probability >= this (0–1).
CHAPTER_THRESHOLD=0.3

# SELECT stage 2: keep articles with probability >= this (0–1).
ARTICLE_THRESHOLD=0.5

# SELECT stage 2: max articles kept per regulation (integer >= 1).
SELECT_TOP_N=8

# OpenAI chat models for scenario generation, comma-separated; first = default (uses OPENAI_API_KEY).
OPENAI_MODELS=gpt-4o-mini-2024-07-18

# Anthropic API key and models for scenario generation, comma-separated; first = default.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELS=

# Inception Labs (OpenAI-compatible) API key, base URL and models, comma-separated; first = default.
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODELS=

# PACK: max tokens (js-tiktoken, approximate) of the article/recital/annex context sent to generation.
PACK_TOKEN_BUDGET=24000

# Sampling temperature for scenario generation (0–2).
LLM_TEMPERATURE=0.2

# Max scenarios per generate request (integer >= 1).
SCENARIO_MAX_COUNT=50

# EVALUATE: verdict fail when any score (0–2) < EVAL_SCORE_FAIL; warn when any score < EVAL_SCORE_PASS.
EVAL_SCORE_PASS=1.3
EVAL_SCORE_FAIL=0.7

# EVALUATE: verdict warn when the duplicate_of_another probability is >= this (0–1).
EVAL_DUP_THRESHOLD=0.7

# COST: USD per 1M tokens as model=input/output, comma-separated, keyed by DECISIONS_MODEL / *_MODELS ids.
# Models without an entry show tokens but no cost. Empty → built-in defaults (gpt-6-luna, gpt-4o-mini, jev-1.14.0).
# DESCRIPTION_MODEL calls are also priced here (scrape job usage).
MODEL_PRICING=gpt-6-luna=0.10/0,gpt-4o-mini-2024-07-18=0.15/0.60,jev-1.14.0=0.042/0

# ===================== Accounts, Qdrant, engines, review (Architecture.md §6) =====================

# --- Auth ---
# JWT signing secret, at least 32 random characters. Required to start the server.
JWT_SECRET=
# Session cookie lifetime in hours.
SESSION_HOURS=8
# First Admin, created by `npm run seed:admin` only if the username does not exist in the shared users collection.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Frontend origin allowed by CORS (with credentials).
CLIENT_ORIGIN=http://localhost:5173

# --- Qdrant (collections are never dropped or recreated) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_USERS_COLLECTION=users
QDRANT_CHECKPOINTS_COLLECTION=checkpoints
QDRANT_MENU_COLLECTION=menucontroller

# --- Menus ---
# Menus a Tester gets when no access record exists. Keys: overview, analyze, runs, review, knowledge, settings.
MENU_DEFAULT_TESTER=overview,analyze,runs

# --- Decision engines: decisions (OpenAI Decisions API) | jev (TypeSafe Jev) ---
# Default engine for every stage.
DECISION_ENGINE=decisions
# Per-stage engine; empty = DECISION_ENGINE.
ROUTE_ENGINE=
SELECT_ENGINE=
REVIEW_ENGINE=
EVAL_ENGINE=
# true: users may pick the classification engine per run.
ENGINE_UI_SWITCH=true
# Retries per engine after the first attempt, and the timeout per attempt (ms).
DECISION_MAX_RETRIES=2
DECISION_TIMEOUT_MS=60000
# Tried in order when the stage engine still fails after retries: engine:model, comma-separated.
DECISION_FALLBACKS=jev:jev-1.14.0
# TypeSafe API key for Jev.
TYPESAFE_API_KEY=
# Jev model; pin a version (thresholds are tuned per version). jev-latest is an alias.
JEV_MODEL=jev-1.14.0
# Questions per Jev request (TypeSafe documents no limit; 64k tokens per request).
JEV_MAX_QUESTIONS_PER_CALL=100

# --- Evaluation ---
# false: the evaluate step and endpoint are off.
EVAL_ENABLED=true

# --- Review agent and human-in-the-loop ---
# Review score 0-100; below = human review.
REVIEW_THRESHOLD=70
# Add-context rounds per run (approve, override and reject stay available after the limit).
HITL_MAX_ROUNDS=3

# --- Generation (LLMs only) ---
# Groq API key and models, comma-separated; first = default. Groq is used for generation only.
GROQ_API_KEY=
GROQ_MODELS=
# Retries per model after the first attempt, and the timeout per attempt (ms).
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=120000
# Tried in order when the chosen model still fails after retries: provider:model, comma-separated
# (same provider with another model, or another provider). Providers: openai, anthropic, groq, inception.
GENERATION_FALLBACKS=

# Tests and local demos only: fake engines and LLMs. Refused when NODE_ENV=production.
CLAUSARIO_FAKE_ENGINES=false
