{
  "name": "clausario-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "qdrant:ping": "tsx scripts/qdrantPing.ts",
    "qdrant:inspect": "tsx scripts/qdrantInspect.ts",
    "setup:menus": "tsx scripts/setupMenus.ts",
    "seed:admin": "tsx scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.6.0",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.3",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.6.1",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@langchain/openai": "^1.8.0",
    "@qdrant/js-client-rest": "1.20.0",
    "@typesafe-ai/sdk": "0.7.0",
    "bcryptjs": "3.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.3",
    "js-tiktoken": "^1.0.21",
    "jsonwebtoken": "9.0.3",
    "openai": "^7.47.0",
    "uuid": "14.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
